@Metadata.layer: #PARTNER
@UI: {
  headerInfo: { 
    typeName: 'Commission Report',
    typeNamePlural: 'Commission Report',
    title: { type: #STANDARD, label: 'Commission Report', value: 'billdoc' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'billdoc', direction: #ASC }] }]
} 


annotate view ZCOMMISION_PV
    with 
{
    @UI.facet: [
    { id: 'ZCommission',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Commission Report',
      position: 10
    },
    {
      position: 10,
      targetElement: 'billdoc'
    }
  ]
  
  @UI.lineItem: [{ position: 10, label: 'Reference Number' }]
  @UI.identification: [{ position: 10, label: 'Reference Number' }]
  @UI.selectionField: [{ position: 10, element: 'billdoc' }]
  billdoc;
  
  @UI.lineItem: [{ position: 20, label: 'Line Item' }]
  @UI.identification: [{ position: 20, label: 'Line Item' }]
  billitem;
  
  @UI.lineItem: [{ position: 30, label: 'Invoice No' }]
  @UI.identification: [{ position: 30, label: 'Invoice No' }]
  invoiceno;
  
  @UI.lineItem: [{ position: 40, label: 'Invoice Date' }]
  @UI.identification: [{ position: 40, label: 'Invoice Date' }]
  invoicedt;
  
  @UI.lineItem: [{ position: 50, label: 'HSN Number' }]
  @UI.identification: [{ position: 50, label: 'HSN Number' }]
  hsncode;
  
  @UI.lineItem: [{ position: 60, label: 'Item Description' }]
  @UI.identification: [{ position: 60, label: 'Item Description' }]
  desct;
  
  @UI.lineItem: [{ position: 70, label: 'Quantity' }]
  @UI.identification: [{ position: 70, label: 'Quantity' }]
  billqty; 
  
  @UI.lineItem: [{ position: 80, label: 'Unit Of Measure' }]
  @UI.identification: [{ position: 80, label: 'Unit Of Measure' }]
  uom;
  
  @UI.lineItem: [{ position: 90, label: 'Sold To Party No' }]
  @UI.identification: [{ position: 90, label: 'Sold To Party No' }]
  @EndUserText.label: 'Sold To Party No' 
  stpno;
  
  @UI.lineItem: [{ position: 100, label: 'Sold To Party Name' }]
  @UI.identification: [{ position: 100, label: 'Sold To Party Name' }]
  @EndUserText.label: 'Sold To Party Name' 
  stpname;
  
  @UI.lineItem: [{ position: 110, label: 'Bill To Party No' }]
  @UI.identification: [{ position: 110, label: 'Bill To Party No' }]
  @EndUserText.label: 'Bill To Party No' 
  btpno;
  
  @UI.lineItem: [{ position: 120, label: 'Bill To Party Name' }]
  @UI.identification: [{ position: 120, label: 'Bill To Party Name' }]
  @EndUserText.label: 'Bill To Party Name'
  btpname;
  
  @UI.lineItem: [{ position: 130, label: 'Payer No' }]
  @UI.identification: [{ position: 130, label: 'Payer No' }]
  @EndUserText.label: 'Payer No'
  pyno;
  
  @UI.lineItem: [{ position: 140, label: 'Payer Name' }]
  @UI.identification: [{ position: 140, label: 'Payer Name' }]
  @EndUserText.label: 'Payer Name'
  pyname;
  
  @UI.lineItem: [{ position: 150, label: 'Ship To Party No' }]
  @UI.identification: [{ position: 150, label: 'Ship To Party No' }]
  @EndUserText.label: 'Ship To Party No'
  shpno;
  
  @UI.lineItem: [{ position: 160, label: 'Ship To Party Name' }]
  @UI.identification: [{ position: 160, label: 'Ship To Party Name' }]
  @EndUserText.label: 'Ship To Party Name'
  shpname;
  
  @UI.lineItem: [{ position: 170, label: 'Postal Code' }]
  @UI.identification: [{ position: 170, label: 'Postal Code' }]
  pin;
  
  @UI.lineItem: [{ position: 180, label: 'Eway Bill Number' }]
  @UI.identification: [{ position: 180, label: 'Eway Bill Number' }]
  ewayno;
  
  @UI.lineItem: [{ position: 190, label: 'LR Number' }]
  @UI.identification: [{ position: 190, label: 'LR Number' }]
  lrno;
  
  @UI.lineItem: [{ position: 200, label: 'LR Date' }]
  @UI.identification: [{ position: 200, label: 'LR Date' }]
  lrdt;
  
  @UI.lineItem: [{ position: 210, label: 'Batch' }]
  @UI.identification: [{ position: 210, label: 'Batch' }]
  Batch;
  
  @UI.lineItem: [{ position: 220, label: 'PO Customer' }]
  @UI.identification: [{ position: 220, label: 'PO Customer' }]
  pono;
  
  @UI.lineItem: [{ position: 230, label: 'Transporter Id BP' }]
  @UI.identification: [{ position: 230, label: 'Transporter Id BP' }]
  transporterid;
  
  @UI.lineItem: [{ position: 240, label: 'Transporter Id S' }]
  @UI.identification: [{ position: 240, label: 'Transporter Id S' }]
  sutprid;
  
  @UI.lineItem: [{ position: 250, label: 'Transporter Name' }]
  @UI.identification: [{ position: 250, label: 'Transporter Name' }]
  sfn;
  
  @UI.lineItem: [{ position: 260, label: 'Delivered Date' }]
  @UI.identification: [{ position: 260, label: 'Delivered Date' }]
  deliv;
  
  @UI.lineItem: [{ position: 270, label: 'UOM Name' }]
  @UI.identification: [{ position: 270, label: 'UOM Name' }]
  uomname;
  
  @UI.lineItem: [{ position: 280, label: 'Commission No' }]
  @UI.identification: [{ position: 280, label: 'Commission No' }]
  comno;
  
  @UI.lineItem: [{ position: 290, label: 'Commission Name' }]
  @UI.identification: [{ position: 290, label: 'Commission Name' }]
  comname;
  
  @UI.lineItem: [{ position: 300, label: 'Commission Value' }]
  @UI.identification: [{ position: 300, label: 'Commission Value' }]
  comamt;
}