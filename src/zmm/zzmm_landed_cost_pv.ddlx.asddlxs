@Metadata.layer: #PARTNER
@UI: {
  headerInfo: { typeName: 'Landed Cost',
                typeNamePlural: 'Landed Cost',
                title: { type: #STANDARD, label: 'Landed Cost', value: 'PurchaseOrder' } },
  presentationVariant: [{ sortOrder: [{ by: 'PurchaseOrder', direction:  #DESC }] }] }
annotate view ZZMM_LANDED_COST_PV with
{
  @UI.facet: [ { id:              'LandedCost',
                 purpose:         #STANDARD,
                 type:            #IDENTIFICATION_REFERENCE,
                 label:           'Landed Cost Report',
                 position:        10 }]
                   
  @UI: {  lineItem:       [ { position: 10, label: 'GRN Year' } ],
          identification: [ { position: 10, label: 'GRN Year' } ] }
  GRYear;
  
  @UI: {  lineItem:       [ { position: 20, label: 'GRN Date' } ],
          identification: [ { position: 20, label: 'GRN Date' } ],
          selectionField: [ { position: 20}  ]}
  GRPostingDate;

  @UI: {  lineItem:       [ { position: 30, label: 'GRN No.' } ],
          identification: [ { position: 30, label: 'GRN No.' } ],
          selectionField: [ { position: 30}  ]}
  GRDocument;

 // @UI: {  lineItem:       [ { position: 40, label: 'GRN item' } ],
 //         identification: [ { position: 40, label: 'GRN item' } ] }
 // grdocumentitem;

  @UI: {  lineItem:         [ { position: 50, label: 'Vendor Name' } ],
          identification:   [ { position: 50, label: 'Vendor Name' } ] }
  VendorName;

  @UI: {  lineItem:         [ { position: 60, label: 'Purchase Order' } ],
          identification:   [ { position: 60, label: 'Purchase Order' } ],
          selectionField:   [ { position: 60}  ]}
  PurchaseOrder;

  @UI: {  lineItem:       [ { position: 70, label: 'Supplier Invoice No' } ],
          identification: [ { position: 70, label: 'Supplier Invoice No' } ] }
  SupplierInvoiceNo;

  @UI: {  lineItem:       [ { position: 80, label: 'Invoice Date' } ],
          identification: [ { position: 80, label: 'Invoice Date' } ] }
  SupplierInvoiceDate;

