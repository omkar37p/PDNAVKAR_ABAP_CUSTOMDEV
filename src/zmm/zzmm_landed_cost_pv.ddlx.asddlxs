//          identification: [ { position: 100, label: 'NARRATION' } ] }
//  narration;

  @UI: {  lineItem:       [ { position: 110, label: 'ITEM NAME' } ],
          identification: [ { position: 110, label: 'ITEM NAME' } ] }
  MaterialDescription;

  @UI: {  lineItem:       [ { position: 120, label: 'HSN NO' } ],
          identification: [ { position: 120, label: 'HSN NO' } ] }
