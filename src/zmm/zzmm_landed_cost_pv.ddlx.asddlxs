  @UI.lineItem          : [{ position: 160, label: 'UOM (Unit of Measure) '  }]
  @UI.identification    : [{ position: 160, label: 'UOM (Unit of Measure) '   }]
  Baseunit;
  
  @UI.lineItem          : [{ position: 170, label: 'Rate / KG '  }]
  @UI.identification    : [{ position: 170, label: 'Rate / KG '  }]
  Rate;
  
  @UI.lineItem          : [{ position: 180, label: 'Taxable Value '  }]
  @UI.identification    : [{ position: 180, label: 'Taxable Value '  }]
