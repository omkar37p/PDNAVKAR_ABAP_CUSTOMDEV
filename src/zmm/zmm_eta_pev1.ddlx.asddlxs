@Metadata.layer:#PARTNER
@UI: { headerInfo :{ typeName: 'ZETA  Report' ,
        typeNamePlural: 'ZETA  Report',
        title: { type: #STANDARD,label: 'ZETA  Report',value: 'PONUM' }},
        presentationVariant: [{ sortOrder: [{ by: 'PONUM',direction: #DESC }] }] }
annotate view zmm_eta_PEV1
    with 
{
@UI.facet: [{ id: 'ZETA  Report',
              purpose: #STANDARD,
              type: #IDENTIFICATION_REFERENCE,
              label: 'ZETA  Report',
              position: 10 },
              {id: 'ZETAReport' ,
              purpose: #STANDARD,
              type: #LINEITEM_REFERENCE,
              label: 'ZETAReport',
              position: 10,
              targetElement: 'PONUM'}]
 @UI: { lineItem: [{ position: 20, label: 'PO NO' }],
       identification: [{ position: 20, label: 'Purchase Order' }],
       selectionField: [{ element: 'PONUM',position: 10 }] }                   
    PONUM;
    
    @UI: { lineItem: [{ position: 21, label: 'Line item' }],
       identification: [{ position: 21, label: 'Line Item' }]}
//       selectionField: [{ element: 'PONUM',position: 10 }] }                   
 lineitem;
    
     @UI: { lineItem: [{ position: 10, label: 'PO DT' }],
       identification: [{ position: 10, label: 'PO DT' }] ,  
       selectionField: [{ element: 'PODT',position: 20 }] }   
