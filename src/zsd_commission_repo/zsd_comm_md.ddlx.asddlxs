@Metadata.layer: #PARTNER

@UI: {
  headerInfo: { 
    typeName: 'Commission Report',
    typeNamePlural: 'Commission Report',
    title: { type: #STANDARD, label: 'Commission Report', value: 'billdoc' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'billdoc', direction: #ASC }] }]
} 

annotate view ZSD_COMM_PV
    with 
{
   @UI.facet: [
    { id: 'ZSalesOrder',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Commission Report',
      position: 10
    },
    {
      position: 10,
      targetElement: 'billdoc'
    }
  ]
 @UI.lineItem: [{ position: 10, label: 'Reference Number'}]
  @UI.identification: [{ position: 10, label: 'Reference Number' }]
  @UI.selectionField: [{ position: 10,element: 'billdoc' }] 
  //@Consumption.valueHelpDefinition: [{ entity: { name: 'I_SalesOrder', element: 'SalesOrder' } }]
  billdoc;
  
  @UI.lineItem: [{ position: 20, label: 'Line Item' }]
  @UI.identification: [{ position: 20, label: ' Line Item' }]
  billitem;
  
